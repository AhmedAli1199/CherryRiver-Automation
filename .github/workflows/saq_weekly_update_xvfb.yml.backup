# BACKUP: GitHub Actions with Xvfb (Virtual Display)
# Use this if headless mode fails on GitHub Actions
# To use: Rename to saq_weekly_update.yml

name: SAQ Weekly Data Update (with Xvfb)

on:
  schedule:
    - cron: '0 8 * * 1'
  workflow_dispatch:

jobs:
  scrape-and-update:
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - name: 📥 Checkout Repository
        uses: actions/checkout@v4

      - name: 🐍 Set up Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: 'pip'

      - name: 📦 Install Python Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: 🌐 Install Chrome and ChromeDriver
        uses: browser-actions/setup-chrome@v1
        with:
          chrome-version: stable

      # NEW: Install Xvfb for virtual display
      - name: 📺 Install Xvfb (Virtual Display)
        run: |
          sudo apt-get update
          sudo apt-get install -y xvfb

      - name: ✓ Verify Chrome Installation
        run: |
          which google-chrome
          google-chrome --version
          which chromedriver
          chromedriver --version

      - name: 📁 Create Download Directory
        run: |
          mkdir -p "SAQ Documents 2"

      # NEW: Run with Xvfb (visible browser on virtual display)
      - name: 🚀 Run SAQ Weekly Pipeline (with Xvfb)
        env:
          SAQ_USERNAME: ${{ secrets.SAQ_USERNAME }}
          SAQ_PASSWORD: ${{ secrets.SAQ_PASSWORD }}
          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          SUPABASE_KEY: ${{ secrets.SUPABASE_KEY }}
          DISPLAY: ':99'
        run: |
          # Start virtual display
          Xvfb :99 -screen 0 1920x1080x24 &
          sleep 3

          # Run pipeline in non-headless mode
          python run_weekly_pipeline.py

      - name: 📤 Upload Downloaded Files
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: saq-data-files-${{ github.run_number }}
          path: SAQ Documents 2/
          retention-days: 7

      - name: 📧 Notify on Failure
        if: failure()
        run: |
          echo "❌ SAQ Pipeline Failed!"
          echo "Check the logs above for details."
